<div class="page cover" style="display: flex; width: 100%; height: 100%;">
    <div style="flex: 1; height: 100%; overflow: hidden;">
        <img src="{{imagePath 'gris.png'}}" alt="" style="width: 100%; height: 100%; object-fit: cover;">
    </div>
    <div style="flex: 1; padding: 40px 30px; display: flex; flex-direction: column; justify-content: center; align-items: center;">
        <div style="display: flex; gap: 10px; align-items: center; margin-bottom: 30px; flex-wrap: wrap; justify-content: center;">
            <h1 style="background-color: rgb(255, 191, 0); border-radius: 10px; padding: 15px 20px; text-align: center; font-size: 50px; margin: 0; font-weight: bold;">Coste Total y Activación {{desglose}}</h1>
        </div>
        <div style="display: flex; flex-direction: column; justify-content: space-between; height: auto; width: 100%; gap: 15px;">
            <p style="color: rgb(255, 191, 0); background: rgb(255, 249, 230); padding: 12px 25px; text-align: center; margin: 0; font-size: 32px; font-weight: bold; width: 70%;">Cuota de Activación <br/> {{resultados.cuotaActivacion}} € + IVA (pago único)</p>
            <p style="color: rgb(255, 191, 0); background: rgb(255, 249, 230); padding: 12px 25px; text-align: center; margin: 0; font-size: 32px; font-weight: bold; width: 70%; margin-left: auto;">Cuota Total <br/> {{resultados.totalEmpleador}} €/mes</p>
            <p style="color: rgb(255, 191, 0); background: rgb(255, 249, 230); padding: 12px 25px; text-align: center; margin: 0; font-size: 32px; font-weight: bold; width: 70%;">Pago Activación <br/> A la Aceptación del Presupuesto</p>
        </div>
    </div>
</div>