<div class="page cover" style="position: relative;">
    <img class="page-logo" src="{{imagePath 'logo.png'}}" alt="Logo CUIDOFAM" style="position: absolute; top: 20px; right: 20px; width: 100px; height: auto; z-index: 10;">
    <div style="display: flex; width: 100%; height: 100%;">
        <div style="flex: 1; display: flex; flex-direction: column; justify-content: center; align-items: center; padding: 60px 40px; padding-top: 80px;">
            <div style="background-color: rgb(255, 191, 0); border-radius: 15px; padding: 20px 25px; text-align: center; font-size: 50px; font-weight: bold; color: rgb(39, 35, 107); line-height: 1.4; margin-bottom: 40px; width: 100%;">
                Presupuesto {{codigoData}}I<br>
                {{nombreContrato}}-{{nombrePueblo}}<br>
                {{tipoServicioTexto}} {{complementoTitulo}}
            </div>
            <p style="text-align: center; font-size: 32px; color: rgb(39, 35, 107); font-weight: bold; margin: 0;">
                <span style="color: rgb(255, 191, 0);">C</span>UIDO<span style="color: rgb(255, 191, 0);">F</span>AM: Servicio de cuidado Interna, {{servicioLugar}}.
            </p>
        </div>
        <div style="flex: 1; height: 100%; overflow: hidden;">
            <img src="{{imagePath 'edificio.png'}}" alt="Edificio Vizcaya" style="width: 100%; height: 100%; object-fit: cover;">
        </div>
    </div>
</div>