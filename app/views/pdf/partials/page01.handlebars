<div class="page cover">
    <img class="page-logo" src="{{imagePath 'logo.png'}}" alt="Logo CUIDOFAM">
    <div class="page-content" style="display: flex; gap: 40px; align-items: center; justify-content: space-between;">
        <div style="flex: 1; display: flex; flex-direction: column; justify-content: center;">
            <h1 style="font-size: 48px; line-height: 1.3; margin: 0; text-align: left;">
                <span style="background-color: rgb(255, 191, 0); border-radius: 10px; padding: 8px 12px; display: block; margin-bottom: 15px;">Presupuesto</span>
                <span style="background-color: rgb(255, 191, 0); border-radius: 10px; padding: 8px 12px; display: block; margin-bottom: 15px; font-size: 42px;">{{codigoData}}I de {{nombreContrato}}-{{nombrePueblo}}</span>
                <span style="background-color: rgb(255, 191, 0); border-radius: 10px; padding: 8px 12px; display: block;">{{tipoServicioTexto}} {{complementoTitulo}}</span>
            </h1>
            <p style="text-align: left; font-size: 28px; margin-top: 30px; color: rgb(39, 35, 107);"><span style="color: rgb(255, 191, 0); font-weight: bold;">C</span>UIDO<span style="color: rgb(255, 191, 0); font-weight: bold;">F</span>AM: Servicio de cuidado, {{servicioLugar}}.</p>
        </div>
        <div style="flex: 1; height: 100%; display: flex; align-items: center; justify-content: center;">
            <img src="{{imagePath 'edificio.png'}}" alt="Edificio Vizcaya" style="width: 100%; height: auto; object-fit: contain; border-radius: 15px;">
        </div>
    </div>
</div>