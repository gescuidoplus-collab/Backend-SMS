        </div>
        <div class="service-item" style="margin-bottom: 20px;">
            <img src="{{imagePath '2.png'}}" alt="">
            <p style="font-size: 22px; color: rgb(39, 35, 107); line-height: 1.4;">{{considerationTwo}}</p>
        </div>
        <div class="service-item">
            <img src="{{imagePath '3.png'}}" alt="">
