    <div style="flex: 1; padding: 40px 30px; display: flex; flex-direction: column; justify-content: center;">
        <div style="display: flex; align-items: center; gap: 15px; margin-bottom: 40px;">
            <img class="page-logo-quinto" src="{{imagePath 'logo.png'}}" alt="" width="100px" style="position: relative; top: 0; left: 0;">
            <h1 style="background-color: rgb(255, 191, 0); border-radius: 10px; padding: 12px 20px; text-align: center; font-size: 28px; margin: 0; font-weight: bold; color: rgb(39, 35, 107); flex: 1;">Consideraciones Adicionales</h1>
        </div>
        <div class="service-item" style="margin-bottom: 20px;">
