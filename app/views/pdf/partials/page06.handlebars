<div class="page cover">
   <div style="position: relative; width: 100%; height: 50%; margin-bottom: 20px;">
        <img src="{{imagePath 'fondo.png'}}" alt="" style="width: 100%; height: 100%; object-fit: cover; display: block;">
        <img src="{{imagePath 'google1.png'}}" alt="" style="position: absolute; right: 30px; top: 50%; transform: translateY(-50%); width: 45%; height: auto; object-fit: contain;">
   </div>
   <div style="padding: 0 30px;">
            <div>
                <h1 style="background-color: rgb(255, 191, 0); border-radius: 10px; padding: 3px; text-align: center; width: 1015px; padding: 5px;font-size: 35px !important;">
                    {{#if desglose}}
                        Desglose del Presupuesto {{desglose}}  {{mensajesPresupuesto}}
                    {{else}}
                        Desglose del Presupuesto {{tipoServicioTexto}} {{mensajesPresupuesto}}
                    {{/if}}
                    </h1>        
                <div style="display: flex; gap: 10px; text-align: center; width: 1015px; justify-content: space-around; margin-top: 30px;">
                    <div>
                        <h2>{{resultados.sueldoNeto}}</h2>
                        <p>Salario Neto <br/> <span style="color: rgb(54, 50, 117) !important; font-size: 15px !important;"> Cuidadora (mes) </span> </p>
                    </div>
                     <div>
                        <h2>{{resultados.cuotaCuidoFam}}  <br/>Cuota CuidoFam</h2>
                        <p>Salario Neto <br/><span style="color: rgb(54, 50, 117) !important; font-size: 15px !important;">  Iva Incluido (mes)</span> </p>
                    </div>
                    <div>
                        <h2>{{resultados.seguridadSocial}}  <br/>Seguridad Social</h2>
                        <p><span style="color: rgb(54, 50, 117) !important; font-size: 15px !important;">Mes</span></p>
                    </div>

                </div>
            </div>
        </div>
</div>